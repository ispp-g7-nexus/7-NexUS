PROJECT_NAME=nexus
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=dev-secret-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx,.nexus.local
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
FRONTEND_PORT=5173
VITE_API_URL=/api
JWT_ACCESS_COOKIE_NAME=access_token
VITE_JWT_ACCESS_COOKIE_NAME=access_token
JWT_ALGORITHM=HS256
JWT_SIGNING_KEY=dev-secret-change-me-at-least-32-chars
JWT_AUDIENCE=
JWT_ACCESS_TOKEN_LIFETIME_SECONDS=3600
JWT_COOKIE_SECURE=0
JWT_COOKIE_SAMESITE=Lax
DEV_DEFAULT_HOST=demo.nexus.local
TENANT_CONTEXT_HOST=demo.nexus.local
TENANT_CONTEXT_PATH=/api/public/tenant-context/
TENANT_BOOTSTRAP_GLOBAL=__NEXUS_DATA__
TENANT_GATEWAY_TIMEOUT_MS=5000
SEED_DEMO_ON_STARTUP=1
DEMO_TENANT_DOMAIN=demo.nexus.local
DEMO_TENANT_SCHEMA=demo
DEMO_TENANT_SLUG=demo
DEMO_TENANT_NAME=Residencia Demo
DEMO_ADMIN_EMAIL=admin@demo.nexus.local
DEMO_STUDENT_EMAIL=estudiante@demo.nexus.local
DEMO_STUDENT_2_EMAIL=estudiante2@demo.nexus.local
DEMO_USERS_PASSWORD=demo1234

POSTGRES_DB=nexus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=0
FIREWORKS_API_KEY=
FIREWORKS_LABEL_MODEL=accounts/fireworks/models/kimi-k2p5
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
PACKAGE_QR_TOKEN_MAX_AGE_SECONDS=300

# Matching module is optional in local dev.
MATCHING_ENABLED=0
INSTALL_MATCHING=0

# Optional future source for room changes used by matching training.
# Example: MATCHING_ROOM_CHANGE_MODEL=rooms.RoomChange
MATCHING_ROOM_CHANGE_MODEL=
MATCHING_ROOM_CHANGE_MEMBERSHIP_FIELD=membership_id

# PostHog analytics
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
