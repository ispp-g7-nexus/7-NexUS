#!/usr/bin/env bash
set -euo pipefail

# commit-msg hook: allow Conventional Commits or merge commits
# Usage: git passes the path to the temporary commit message file as $1

MSG_FILE="$1"

if [ ! -f "$MSG_FILE" ]; then
  echo "commit-msg: missing message file"
  exit 1
fi

FIRST_LINE=$(sed -n '1p' "$MSG_FILE" | tr -d '\r')

# Allow merge commits (messages starting with "Merge")
if echo "$FIRST_LINE" | grep -Eiq '^merge'; then
  exit 0
fi

# Conventional Commits regex (allow optional scope and optional !)
RE='^(feat|fix|docs|style|refactor|perf|test|chore|build|ci|revert|ops|infra)(\([^\)]+\))?(!)?: .+'

if echo "$FIRST_LINE" | grep -Eiq -- "$RE"; then
  exit 0
fi

cat <<'ERROR'
ERROR: Commit message rejected.
Your commit message must follow Conventional Commits (e.g. "feat(auth): add login")
or be a merge commit (starting with "Merge").

Allowed types: feat, fix, docs, style, refactor, perf, test, chore, build, ci, revert, ops, infra
ERROR

exit 1
