// ==========================================
// TENANTS MODULE (App: tenants)
// ==========================================

Table Plan {
  id integer [primary key]
  code varchar [unique]
  name varchar
  description text
  max_residences integer [default: 1]
  allows_whitelabel boolean [default: false]
  is_active boolean [default: true]
  created_at timestamp
  updated_at timestamp
}

Table Client { // Inherits from TenantMixin
  id integer [primary key]
  schema_name varchar [unique] // Core of django_tenants
  name varchar
  slug varchar [unique]
  plan_id integer [ref: > Plan.id]
  is_active boolean [default: true]
  created_at timestamp
  updated_at timestamp
  paid_until date
  on_trial boolean [default: true]
  whitelabel_enabled boolean [default: false]
  metadata json
}

Table Domain { // Inherits from DomainMixin
  id integer [primary key]
  domain varchar [unique]
  tenant_id integer [ref: > Client.id]
  is_primary boolean
}

// ==========================================
// RESIDENCES MODULE (App: residences)
// ==========================================

Table Residence {
  id integer [primary key]
  name varchar
  slug varchar [unique]
  code varchar [unique]
  timezone varchar [default: 'Europe/Madrid']
  is_active boolean [default: true]
  created_at timestamp
  updated_at timestamp
}

Table ResidenceBranding {
  id integer [primary key]
  residence_id integer [unique, ref: - Residence.id] // One-to-One relationship
  primary_color varchar [default: '#0F4C81']
  secondary_color varchar [default: '#F4B400']
  accent_color varchar [default: '#2E7D32']
  logo_url varchar
  favicon_url varchar
  custom_css text
  updated_at timestamp
}

Table ResidenceDomain {
  id integer [primary key]
  residence_id integer [ref: > Residence.id]
  domain varchar [unique]
  is_primary boolean [default: false]
  is_active boolean [default: true]
  created_at timestamp
}

Table Membership {
  id integer [primary key]
  user_id integer [ref: > User.id]
  role varchar // Options: portfolio_admin, residence_admin, resident
  residence_id integer [ref: > Residence.id] // Nullable (Portfolio admins are not tied to a specific residence)
  is_active boolean [default: true]
  created_at timestamp
  updated_at timestamp
}

Table Announcement {
  id integer [primary key]
  residence_id integer [ref: > Residence.id] 
  user_id integer [ref: > User.id]      
  title varchar
  description text
  featured boolean [default: false]
  publication_date timestamp
  category varchar(20) // Enum: URGENT, MAINTENANCE, EVENT, HELP, GENERAL
  expiry_date date      // Date when the announcement expires
  created_at timestamp  
  updated_at timestamp  
}

// ==========================================
// BASIC USERS MODULE (Django Auth)
// ==========================================

Table User { // Represents settings.AUTH_USER_MODEL
  id integer [primary key]
  email varchar [unique]
  password varchar
  first_name varchar
  last_name varchar
  is_active boolean
  // Note: Roles and residence associations are managed via 'Membership' table
}

// ==========================================
// CONCEPTUAL MODEL (Extended logic)
// ==========================================

Table Room {
  id integer [primary key]
  number varchar
  floor integer
  max_capacity integer
  type varchar // Individual or Shared
  residence_id integer [ref: > Residence.id]
}

Table StudentProfileExtension {
  student_id integer [primary key, ref: - User.id]
  room_id integer [ref: > Room.id]
  bio text
  age integer
  university varchar
  degree varchar
  gender varchar
  onboarding_status varchar
  
  // Matching Form Attributes
  share_with_different_gender boolean
  schedule_rhythm varchar // Early bird / Night owl
  preferred_study_place varchar
  sociability_level integer
  weekend_stay varchar
  outside_socializing_importance varchar
  cleanliness_order_level integer
  noise_tolerance integer
  smoking_vaping_habit varchar
  guest_policy varchar
  favorite_activities text
  shared_expense_management varchar
  temperature_sensitivity varchar
}

// --- OPERATIONAL MODULE: INCIDENT PIPELINE ---

Table Incident {
  id integer [primary key]
  title varchar
  description text
  image_url varchar
  status varchar // Registered, In Progress, Resolved
  priority varchar
  created_at timestamp
  creator_id integer [ref: > User.id]
  assigned_id integer [ref: > User.id]
  room_id integer [ref: > Room.id]
  resource_id integer [ref: > Resource.id]
}

Table IncidentSubtask {
  id integer [primary key]
  incident_id integer [ref: > Incident.id]
  description text
  is_completed boolean
}

// --- SOCIAL AND BOOKING MODULE ---

Table Resource {
  id integer [primary key]
  name varchar
  type varchar // Space (Gym) or Object (Paddle Racket)
  max_capacity integer [default: 1]
  description text
  residence_id integer [ref: > Residence.id]
}

Table Booking {
  id integer [primary key]
  user_id integer [ref: > User.id]
  resource_id integer [ref: > Resource.id]
  start_date timestamp
  end_date timestamp
  status varchar
}

Table Event {
  id integer [primary key]
  title varchar
  description text
  date_time timestamp
  location varchar
  organizer_id integer [ref: > User.id]
  residence_id integer [ref: > Residence.id]
}

Table EventAttendance {
  user_id integer [ref: > User.id]
  event_id integer [ref: > Event.id]
  primary key (user_id, event_id)
}

// --- IA MATCHING AND CONTROL LOGIC ---

Table SuggestedMatch {
  id integer [primary key]
  resident_a_id integer [ref: > User.id]
  resident_b_id integer [ref: > User.id]
  affinity_percentage float
  status varchar // Pending, Accepted, Rejected
}

Table Guest {
  id integer [primary key]
  host_id integer [ref: > User.id]
  residence_id integer [ref: > Residence.id]
  full_name varchar
  id_document varchar
  start_date timestamp
  end_date timestamp
  access_status varchar
}