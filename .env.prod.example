PROJECT_NAME=nexus
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change-this-in-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com,api.tu-dominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com
FRONTEND_PORT=5173
VITE_API_URL=/api
JWT_ACCESS_COOKIE_NAME=access_token
VITE_JWT_ACCESS_COOKIE_NAME=access_token
JWT_ALGORITHM=HS256
JWT_SIGNING_KEY=change-this-in-production-at-least-32-chars
JWT_AUDIENCE=
JWT_ACCESS_TOKEN_LIFETIME_SECONDS=3600
JWT_COOKIE_SECURE=1
JWT_COOKIE_SAMESITE=Lax
TENANT_CONTEXT_HOST=demo.nexus.local
TENANT_CONTEXT_PATH=/api/public/tenant-context/
TENANT_BOOTSTRAP_GLOBAL=__NEXUS_DATA__
TENANT_GATEWAY_TIMEOUT_MS=5000
SEED_DEMO_ON_STARTUP=0
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

POSTGRES_DB=nexus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-in-production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=0
